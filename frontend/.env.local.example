# Frontend environment variables
# Copy to .env.local and fill in your values

# API Gateway URL (no trailing slash)
# In dev: use sam local start-api proxy URL or http://localhost:3000
# In prod: your CloudFront domain, e.g. https://d1abc123.cloudfront.net
VITE_API_URL=http://localhost:3000

# Cognito User Pool ID (from SAM deploy outputs)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito User Pool App Client ID (from SAM deploy outputs)
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region
VITE_REGION=us-east-1
